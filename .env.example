# matrix-mcp runtime config — template. Copy to `.env` (chmod 600) and fill in.
#
# One tenant = one homeserver + one Matrix account on it. Add as many
# TENANT_<NAME>_* blocks as you like; <NAME> becomes the (lowercased) value
# you pass in the optional `tenant` tool argument. With a single tenant you
# never need to pass `tenant` at all.

# --- tenant: "personal" (rename freely) ---
TENANT_PERSONAL_BASE_URL=https://matrix.example.org
TENANT_PERSONAL_USER_ID=@alice:example.org
TENANT_PERSONAL_TOKEN=REPLACE_WITH_MATRIX_ACCESS_TOKEN

# --- optional second tenant, e.g. matrix.org ---
# TENANT_MATRIXORG_BASE_URL=https://matrix-client.matrix.org
# TENANT_MATRIXORG_USER_ID=@alice:matrix.org
# TENANT_MATRIXORG_TOKEN=REPLACE_WITH_MATRIX_ACCESS_TOKEN

# Which tenant to use when the `tenant` argument is omitted.
# Defaults to the alphabetically first tenant if unset.
# MATRIX_PRIMARY_TENANT=personal

# --- HTTP transport only (not needed for --stdio) ---
# Shared secret MCP clients must present as `Authorization: Bearer <token>`.
# REQUIRED for HTTP mode; the server refuses to start without it.
# Generate with: openssl rand -hex 32
MCP_BEARER_TOKEN=REPLACE_ME

# Bind address / port. HOST defaults to 127.0.0.1 (Docker image sets 0.0.0.0).
# HOST=127.0.0.1
# PORT=3300

# Max decoded size for matrix_send_file uploads, in bytes (default 10 MiB).
# MATRIX_MCP_MAX_UPLOAD_BYTES=10485760
